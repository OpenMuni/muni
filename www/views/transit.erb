<div
  class="shell shell--transit native-app"
  data-hall="<%= @hall.slug %>">
  <header class="topbar ui-material native-chrome">
    <%= erb :_municipality_selector, layout: false %>
    <nav class="topbar__nav" aria-label="Site">
      <%= erb :_water_region_link, layout: false %>
      <a class="topbar__link" href="/about?hall=<%= @hall.slug %>">About</a>
    </nav>
  </header>

  <main class="shell__body transit-shell__body">
    <nav class="rail native-sidebar" aria-label="Apps">
      <div class="rail__primary">
        <%= erb :_app_rail, layout: false, locals: { current_app: :transit } %>
        <%= erb :_category_rail, layout: false %>
      </div>
    </nav>

    <div id="root" class="transit-viewport" aria-label="MBTA Transit Radar and Statistics"></div>
  </main>
</div>
