      <dialog x-ref="evidenceDialog" class="water-dialog" @close="detail=null"><form method="dialog"><button class="ui-button" autofocus>Close</button></form><h2>Source evidence</h2>
        <template x-if="detail"><div><a :href="detail.record.source_url" target="_blank" rel="noopener">Source ↗</a>
          <dl class="detail__props"><div class="detail__pair"><dt>Location</dt><dd x-text="locationName(detail.record.location_id)"></dd></div><div class="detail__pair"><dt>Result</dt><dd x-text="detail.record.kind==='discharge' ? dischargeValue(detail.record) : value(detail.record) + ' ' + (detail.record.unit || '')"></dd></div><div class="detail__pair"><dt>Observed</dt><dd x-text="observationStamp(detail.record)"></dd></div><div class="detail__pair"><dt>This version retrieved</dt><dd x-text="stamp(detail.record.fetched_at)"></dd></div><div class="detail__pair"><dt>Status</dt><dd x-text="detail.record.kind==='laboratory' ? eligibilityLabel(detail.record) : label(detail.record.status)"></dd></div><div class="detail__pair"><dt>Method</dt><dd x-text="detail.record.method || 'Not supplied'"></dd></div></dl>
          <dl class="detail__props"><div class="detail__pair"><dt>Source update time</dt><dd x-text="stamp(detail.record.published_at)"></dd></div><div class="detail__pair"><dt>Date precision</dt><dd x-text="label(detail.record.time_precision || detail.record.payload?.time_precision || 'time')"></dd></div><div class="detail__pair"><dt>Source publications</dt><dd x-text="detail.record.publication_count || detail.record.payload?.publication_count || 1"></dd></div><div class="detail__pair"><dt>Calculation eligibility</dt><dd x-text="detail.record.eligibility?.calculation === true ? 'Eligible under the stated policy' : detail.record.eligibility?.calculation === false ? 'Excluded from calculations' : 'Not specified'"></dd></div></dl>
          <p x-show="detail.record.eligibility?.reasons?.length" x-text="detail.record.eligibility?.reasons?.map(reason=>label(reason)).join(' · ')"></p>
          <p class="muted" x-show="detail.record.payload?.limitation" x-text="detail.record.payload?.limitation"></p>
          <details><summary>Provenance and normalization policy</summary><dl class="detail__props"><div class="detail__pair"><dt>Record identity</dt><dd x-text="detail.record.external_id"></dd></div><div class="detail__pair"><dt>Source identity</dt><dd x-text="detail.record.source_record_id || detail.record.payload?.source_record_id || 'See original publication'"></dd></div><div class="detail__pair"><dt>Revision ID</dt><dd x-text="detail.record.revision_id ?? 'Not retained'"></dd></div><div class="detail__pair"><dt>Query revision cutoff</dt><dd x-text="detail.revision_cutoff ?? 'Not supplied'"></dd></div><div class="detail__pair"><dt>Calculation policy</dt><dd x-text="detail.policy_version || 'Not supplied'"></dd></div><div class="detail__pair"><dt>Normalization version</dt><dd x-text="detail.record.normalization_version || 'Not supplied'"></dd></div><div class="detail__pair"><dt>Method / deployment</dt><dd x-text="[detail.record.method,detail.record.segment].filter(Boolean).join(' · ') || 'Not supplied'"></dd></div></dl><p>Source publications and revisions remain available. Grouped publications do not establish that separate samples are equivalent.</p></details>
          <template x-if="detail.record.kind==='discharge'"><dl class="detail__props"><template x-for="item in [['Operator','operator'],['Receiving water','receiving_water'],['Ended','ends_at'],['Historical average','historical_average'],['Treatment','treatment_status'],['Rainfall (inches)','rainfall'],['Review','review_reason']]"><div class="detail__pair"><dt x-text="item[0]"></dt><dd x-text="detail.record.payload[item[1]] ?? 'Not supplied'"></dd></div></template></dl></template>
          <template x-for="revision in detail.revisions" :key="revision.id"><details><summary x-text="'Version ' + revision.version + ' · revision ' + revision.id + (revision.id === detail.record.revision_id ? ' · selected' : '') + ' · detected ' + stamp(revision.detected_at)"></summary><pre x-text="JSON.stringify(revision.record,null,2)"></pre></details></template>
        </div></template>
      </dialog>
      <dialog x-ref="signalDialog" class="water-dialog" @close="selectedSignal=null"><form method="dialog"><button class="ui-button" autofocus>Close</button></form>
        <template x-if="selectedSignal"><div><h2 x-text="signalTitle(selectedSignal)"></h2><p x-text="signalWindow(selectedSignal)"></p><p x-text="selectedSignal.payload.explanation"></p>
          <a :href="'/api/water/charles/signals/'+selectedSignal.id+'/evidence'">Calculation inputs</a> · <a :href="'/api/water/charles/signals?versions=1&key='+encodeURIComponent(selectedSignal.signal_key)">Signal versions</a>
          <details><summary>Calculation</summary><pre x-text="JSON.stringify(selectedSignal.payload,null,2)"></pre></details>
        </div></template>
      </dialog>
