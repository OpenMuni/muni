<%
  water_region = @water_region == true
  form_target = (defined?(request) && request&.respond_to?(:path_info) && !request.path_info.to_s.empty?) ? request.path_info : '/'
%>
<div class="brand">
  <a class="brand__word brand__home" href="<%= water_region ? '/water/charles' : "/?hall=#{@hall.slug}" %>" aria-label="Muni home">Muni</a>
  <form class="municipality-selector" method="get" action="<%= form_target %>"
        data-selected="<%= water_region ? 'Charles River' : Rack::Utils.escape_html(@hall.name) %>">
    <select name="hall" aria-label="<%= water_region ? 'Region' : 'Municipality' %>"
            onchange="if (this.value === 'charles') { window.location.assign('/water/charles'); } else { this.form.requestSubmit(); }">
      <% Muni::Hall.all.select(&:public?).sort_by(&:name).each do |hall| %>
        <option value="<%= Rack::Utils.escape_html(hall.slug) %>"<%= ' selected' if !water_region && hall.slug == @hall.slug %>>
          <%= Rack::Utils.escape_html(hall.name) %>
        </option>
      <% end %>
      <% if Muni::Water.enabled? %>
        <option value="charles"<%= ' selected' if water_region %>>Charles River</option>
      <% end %>
    </select>
  </form>
</div>
