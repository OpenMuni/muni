<%
  water_region = @water_region == true
  subway_region = @mobility_region == true
  regional = water_region || subway_region
%>
<div class="brand">
  <a class="brand__home" href="<%= regional ? '/' : "/?hall=#{@hall.slug}" %>" aria-label="OpenMuni home">
    <img class="brand__logo" src="/icons/openmuni-logo.png" alt="" width="23" height="28">
    <span class="brand__word">OpenMuni</span>
  </a>
  <form class="municipality-selector" method="get" action="/"
        data-selected="<%= water_region ? 'Charles River' : (subway_region ? 'MBTA Subway' : Rack::Utils.escape_html(@hall.name)) %>">
    <select name="hall" aria-label="<%= regional ? 'Region' : 'Municipality' %>"
            onchange="if (this.value === 'charles') { window.location.assign('/water/charles'); } else if (this.value === 'subway') { window.location.assign('/mobility/subway'); } else { this.form.requestSubmit(); }">
      <% Muni::Hall.all.select(&:public?).sort_by(&:name).each do |hall| %>
        <option value="<%= Rack::Utils.escape_html(hall.slug) %>"<%= ' selected' if !regional && hall.slug == @hall.slug %>>
          <%= Rack::Utils.escape_html(hall.name) %>
        </option>
      <% end %>
      <% if Muni::Water.enabled? %>
        <option value="charles"<%= ' selected' if water_region %>>Charles River</option>
      <% end %>
      <option value="subway"<%= ' selected' if subway_region %>>MBTA Subway</option>
    </select>
  </form>
</div>
