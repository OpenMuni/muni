<% account = navigation_account %>
<% if Muni::Www::Auth.mode == 'public' %>
  <% if account %>
    <% label = account[:first_name].to_s.empty? ? 'Account' : account[:first_name] %>
    <a class="topbar__link account-nav" href="/account" aria-label="<%= h("#{label} — Account") %>"><bdi><%= h(label) %></bdi></a>
  <% else %>
    <a class="topbar__link account-nav" href="/login">Login</a>
  <% end %>
<% end %>
