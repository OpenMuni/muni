<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>Muni · <%= @water_region ? 'Charles River' : (@transit_app ? 'Transit' : (@hall&.name || 'muni.fyi')) %></title>
  <% asset_version = [File.mtime(File.join(settings.public_folder, 'css/muni.css')).to_i,
                      File.mtime(File.join(settings.public_folder, 'js/muni.js')).to_i].max %>
  <link rel="preconnect" href="https://unpkg.com">
  <link rel="stylesheet" href="/vendor/maplibre-gl/maplibre-gl.css">
  <link rel="stylesheet" href="/css/muni.css?v=<%= asset_version %>">
  <% if @transit_app %>
    <link rel="stylesheet" href="/transit/assets/index.css">
  <% end %>
  <script src="https://unpkg.com/pmtiles@4.5.0/dist/pmtiles.js" integrity="sha384-pbKNZbDshUsLnZMIVsn/t+j3xEY9PGfuX5Z22l5rcy/obXz3EwaMx1F5d9sRsJMn" crossorigin="anonymous"></script>
  <script src="https://unpkg.com/@protomaps/basemaps@5.7.2/dist/basemaps.js" integrity="sha384-fzuU7k7ZWwfZAe1+3h7plrSA6dNazJaM2NsKVwcrReJLK0gwVwyOSyPwROl9m1M0" crossorigin="anonymous"></script>
  <script>
    window.MUNI_MAP_READY = import('/vendor/maplibre-gl/maplibre-gl.mjs').then(module => {
      window.maplibregl = module;
      return module;
    });
    window.MUNI_MAP_READY.catch(() => {});
    window.MUNI_MAPTILER_KEY = <%= (@maptiler_key || '').to_json %>;
    window.MUNI_MAP_STYLE = <%= (@map_style || '').to_json %>;
    window.MUNI_MAP_TILES = <%= @map_tiles.to_json %>;
    window.MUNI_PMTILES_URL = <%= (@pmtiles_url || '/tiles/muni.pmtiles').to_json %>;
    window.MUNI_PMTILES_READY = <%= !!@pmtiles_ready %>;
    window.MUNI_BASEMAP_MODE = <%= (@basemap_mode || 'auto').to_json %>;
    window.MUNI_BASEMAP_ERROR = <%= @basemap_error.to_json %>;
    window.MUNI_QUERY_LIMIT = <%= Muni::View::DEFAULT_QUERY_LIMIT %>;
    window.MUNI_DISPLAY = <%= Muni::Display.contract.to_json %>;
    window.MUNI_HALL = <%= (@hall&.slug || 'cambridge').to_json %>;
  </script>
</head>
<body>
  <%= yield %>
  <script src="/js/muni.js?v=<%= asset_version %>"></script>
  <script src="https://unpkg.com/alpinejs@3.17.4/dist/cdn.min.js" defer integrity="sha384-5/joNqFnRyVWzXp99bHot6RHG+EksGp+USSgZwPar7T9SD9PKKER37n/8bXBAZGd" crossorigin="anonymous"></script>
  <% if @transit_app %>
    <script type="module" src="/transit/assets/index.js"></script>
  <% end %>
</body>
</html>
