# Default development and self-hosting need only this line.
MUNI_AUTH_MODE=off
# Enable only after the pool and management flows have passed testing.
MUNI_AUTH_PASSKEYS_ENABLED=0
MUNI_PUBLIC_BASE_URL=https://muni.example
MUNI_COGNITO_DOMAIN=https://auth.muni.example
MUNI_COGNITO_POOL_ID=us-east-1_REPLACE
MUNI_COGNITO_CLIENT_ID=REPLACE
# Actual socket peers, not arbitrary client-supplied forwarding headers.
MUNI_AUTH_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# load-secrets.py adds MUNI_COGNITO_CLIENT_SECRET and MUNI_AUTH_ENCRYPTION_KEY.
