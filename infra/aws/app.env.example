# Docker --env-file syntax. Operator configuration; no credentials in Git.
RACK_ENV=production
MUNI_DB_PATH=/data/muni.sqlite3
MUNI_BACKUP_PATH=/data/backups
MUNI_TILES_PATH=/data/tiles
MUNI_PUBLIC_BASE_URL=https://example.org
MUNI_PUBLIC_HALLS=cambridge,boston
MUNI_WEB_BEATS=1
# Add optional publisher/API credentials locally. See docs/SELF_HOSTING.md.
